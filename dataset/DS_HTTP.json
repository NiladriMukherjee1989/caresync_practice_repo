{
	"name": "DS_HTTP",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_HTTP",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"folder_path": {
				"type": "string",
				"defaultValue": "NiladriMukherjee1989/Walmart_Airflow_DBT_Project/refs/heads/main/walmart_dataset/data/"
			},
			"file_name": {
				"type": "string",
				"defaultValue": "customers.csv"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "HttpServerLocation",
				"relativeUrl": {
					"value": "@concat(dataset().folder_path,dataset().file_name)",
					"type": "Expression"
				}
			},
			"columnDelimiter": ",",
			"rowDelimiter": "\n",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}