							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_CSV",
									"type": "DatasetReference",
									"parameters": {
										"container": "source",
										"folder": "raw",
										"file": {
											"value": "@item().name",
											"type": "Expression"
										}
