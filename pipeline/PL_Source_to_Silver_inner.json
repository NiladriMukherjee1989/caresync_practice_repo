{
	"name": "PL_Source_to_Silver_inner",
	"properties": {
		"activities": [
			{
				"name": "Set Start_TS",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "start_TS",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd-hh-mm-ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Lookup_single_table",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.table_config\nwhere table_id=@{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzuresqlDatabase",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Ingest actual data",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Set Start_TS",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Lookup_single_table",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "select * from public.@{activity('Lookup_single_table').output.firstRow.source_table_name}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Postgres",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS",
						"type": "DatasetReference",
						"parameters": {
							"container": "landing",
							"folder": {
								"value": "@concat(activity('Lookup_single_table').output.firstRow.source_system, '/',activity('Lookup_single_table').output.firstRow.source_table_name,'/',variables('start_TS'))",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "SOURCE_TO_BRONZE",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Ingest actual data",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/caresync/caresync_practice_repo_databricks/SOURCE_TO_BRONZE",
					"baseParameters": {
						"source_system": {
							"value": "@activity('Lookup_single_table').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Lookup_single_table').output.firstRow.source_table_name",
							"type": "Expression"
						},
						"ingested_ts": {
							"value": "@variables('start_TS')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "BRONZE_TO_SILVER",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "SOURCE_TO_BRONZE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/caresync/caresync_practice_repo_databricks/BRONZE_TO_SILVER",
					"baseParameters": {
						"table_name": {
							"value": "@activity('Lookup_single_table').output.firstRow.source_table_name",
							"type": "Expression"
						},
						"ingested_ts": {
							"value": "@variables('start_TS')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Update Audit table Success",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "BRONZE_TO_SILVER",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSqlDatabase",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update ctrl.audit_log  set STATUS='SUCCESS',END_TIME=SYSUTCDATETIME(), records_written=@{activity('BRONZE_TO_SILVER').output.runOutput}\nWHERE  adf_run_id='@{pipeline().parameters.adf_run_id}' and table_id=@{pipeline().parameters.table_id} and status='IN_PROGRESS';",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Set variable",
				"type": "SetVariable",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "BRONZE_TO_SILVER",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "run_id",
					"value": {
						"value": "@pipeline().parameters.adf_run_id",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set variable_copy1",
				"type": "SetVariable",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "BRONZE_TO_SILVER",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "table_id",
					"value": {
						"value": "@string(pipeline().parameters.table_id)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string",
				"defaultValue": "1"
			},
			"adf_run_id": {
				"type": "string",
				"defaultValue": "default_value"
			}
		},
		"variables": {
			"start_TS": {
				"type": "String"
			},
			"run_id": {
				"type": "String"
			},
			"table_id": {
				"type": "String"
			},
			"table_id_1": {
				"type": "Integer"
			}
		},
		"annotations": []
	}
}