{
	"name": "PL_copy_API_files",
	"properties": {
		"activities": [
			{
				"name": "Web1",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"headers": {
						"User-Agent": "adf"
					},
					"url": "https://github.com/NiladriMukherjee1989/ADF_practice_files/tree/main/RawData"
				}
			},
			{
				"name": "Filter1",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Web1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Web1').output.Response",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().type, 'file')",
						"type": "Expression"
					}
				}
			}
		],
		"annotations": []
	}
}